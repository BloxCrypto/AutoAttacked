{
  "schemaVersion": 1,
  "id": "autoattack",
  "version": "${version}",
  "name": "Auto Attack",
  "description": "Automatically attacks living entities under the crosshair.",
  "authors": [
    {
      "name": "Zvalz"
    }
  ],
  "license": "MIT",
  "icon": "assets/autoattack/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.kodari.autoattack.AutoAttackMod"
    ],
    "client": [
      "com.kodari.autoattack.AutoAttackClient"
    ],
    "modmenu": [
      "com.kodari.autoattack.AutoAttackModMenu"
    ]
  },
  "mixins": [
    {
      "config": "autoattack.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "yet_another_config_lib_v3": ">=3.8.0",
    "modmenu": ">=17.0.1-beta.1"
  }
